[Unit]
Description=Sesja Maestro (Claude Code z Remote Control w tmux)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=forking
User=maestro
Group=maestro
WorkingDirectory=/home/maestro/maestro
Environment=HOME=/home/maestro
ExecStart=/usr/bin/tmux new-session -d -s maestro /usr/local/lib/fabryka-serwer/start-maestro.sh
ExecStop=/usr/bin/tmux kill-session -t maestro
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
